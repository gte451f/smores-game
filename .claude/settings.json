{
  "permissions": {
    "allow": [
      "mcp__unreal-mcp__call_tool",
      "mcp__unreal-mcp__describe_toolset",
      "mcp__unreal-mcp__list_toolsets",
      "Bash(tasklist *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/save_approved_plan.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
